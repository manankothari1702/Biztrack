# Copy to .env and fill in. .env is gitignored and must stay that way.
# Generate secrets, never choose them:
#   openssl rand -base64 24   -> POSTGRES_PASSWORD
#   openssl rand -base64 32   -> JWT_SECRET
# Save both to the password manager the moment you generate them.

APP_NAME=<APP>
APP_TITLE=<APP_TITLE>
APP_DOMAIN=<APP>.example.co.in

POSTGRES_DB=<APP>db
POSTGRES_USER=<APP>user
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=12
AUTH_ISSUER=https://auth.example.co.in

ADMIN_EMAIL=
ADMIN_PASSWORD=CHANGE_ON_FIRST_LOGIN

TZ=Asia/Kolkata
BACKUP_RETENTION_DAYS=30
PLATFORM_VERSION=1.0.0
