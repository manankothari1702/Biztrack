{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "types": ["node"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*"],
    // Test files must never reach dist/ — CDK packages this whole directory
    // (minus src/) into the Lambda asset, and a shipped *.test.js would carry a
    // require('vitest') that is not a production dependency.
    // Typecheck them separately: tsc -p tsconfig.test.json
    "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
