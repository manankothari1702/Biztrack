# Frontend environment variables — copy to .env and fill in values from CDK stack outputs
# Run: cd infra && npx cdk deploy  (outputs these values)
# NEVER commit .env with real values to version control

# Cognito User Pool ID  (CDK output: UserPoolId)
VITE_COGNITO_USER_POOL_ID=

# Cognito App Client ID  (CDK output: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=

# Cognito Hosted UI domain  (CDK output: CognitoDomain)
VITE_COGNITO_DOMAIN=

# API Gateway URL  (CDK output: ApiUrl)
# Keep this ABSOLUTE — it is what production builds ship with.
VITE_API_URL=

# CloudFront URL  (CDK output: CloudFrontUrl)
VITE_APP_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Local development — the dev API proxy
# ─────────────────────────────────────────────────────────────────────────────
#
# The deployed API's CORS allowlist trusts ONLY the CloudFront origin. That is
# deliberate: security audit C3 replaced a wildcard `*`. A browser at
# http://localhost:5173 calling the API directly receives a 204 preflight whose
# Access-Control-Allow-Origin names CloudFront, so the browser discards the
# response and reports an opaque "CORS error".
#
# The fix is NOT to add localhost to the production allowlist. Instead the Vite
# dev server proxies /api/* to API Gateway (`server.proxy` in vite.config.ts).
# The browser talks to its own origin, so no preflight is sent and CORS never
# applies.
#
# To enable it, create a **`.env.development.local`** (gitignored) containing:
#
#     VITE_API_URL=/api
#
# ⚠️ The filename matters. Use `.env.development.local`, NOT `.env.local`:
# Vite loads `.env.local` in EVERY mode, including `vite build`, so the relative
# path would be baked into the production bundle and the deployed app would call
# /api/* on the CloudFront origin, where nothing is listening.
# `.env.development.local` loads only under `npm run dev`, leaving
# `npm run build` to read the absolute URL from `.env`.
#
# Optional: export VITE_API_PROXY_TARGET before `npm run dev` to point the proxy
# somewhere other than the default prod API.
#
# See the "Local development" section of README.md for the full workflow,
# including the dedicated Cognito dev user.
