#!/usr/bin/env bash
# Runs the release gate's fast tier before every commit.
#
# NOT ENABLED YET. Turn it on with:
#
#     git config core.hooksPath .githooks
#
# It is deliberately left opt-in: `./verify.sh --fast` is currently RED because
# `npm run lint` has 15 pre-existing errors (recorded in the AI-EOS adoption
# baseline, 2026-08-05). Enabling the hook today would block every commit and
# teach everyone to reach for --no-verify, which is worse than no hook at all.
#
# Enable it the day lint goes green. That is the point of tracking FU-EOS-4.
exec ./verify.sh --fast
