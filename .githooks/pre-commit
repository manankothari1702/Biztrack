#!/usr/bin/env bash
# Runs the release gate's fast tier before every commit.
#
# ENABLED 2026-08-06, once FU-EOS-4 cleared the last of the 15 lint errors and
# `./verify.sh --fast` went green. Each clone must opt in once, because
# core.hooksPath is local config and cannot be committed:
#
#     git config core.hooksPath .githooks
#
# Confirm with `git config core.hooksPath` - it should print `.githooks`.
#
# It stayed off until lint went green on purpose: a hook that blocks every
# commit teaches everyone to reach for --no-verify, which is worse than no hook.
#
# On Linux and macOS this needs `verify.sh` to carry the executable bit, which
# it does not yet - see FU-EOS-8. Windows ignores the mode bit, so the hook runs
# there today.
exec ./verify.sh --fast
